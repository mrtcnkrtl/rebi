			</array>
		</dict>
	</array>
	<!--
		Uygulama kodunun kendisi "gerekçe gerektiren API" çağırmaz; Flutter motoru ve eklentiler
		(shared_preferences, package_info_plus…) kendi gizlilik dosyalarını paketle getirir.
	-->
	<key>NSPrivacyAccessedAPITypes</key>
	<array/>
</dict>
</plist>
