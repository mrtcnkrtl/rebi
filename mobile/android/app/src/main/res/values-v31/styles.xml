<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ sistem açılış ekranı: derin yeşil zeminde marka logosu. Logo, uygulama ikonunun (108 dp'lik
         uyarlanabilir tuval) 288 dp'ye büyütülmüş hâli olmasın diye ayrı bir vektördür: PNG olsaydı pikselleşirdi. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/splash_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_logo</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
