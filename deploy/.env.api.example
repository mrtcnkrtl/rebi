# Bu dosyayı deploy/.env.api olarak kopyalayın (asla git'e eklemeyin)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=
SUPABASE_KEY=
GEMINI_API_KEY=
OPENWEATHER_API_KEY=

# Üretim web kökenleri (virgülle)
CORS_ORIGINS=https://rebiovil.com,https://www.rebiovil.com,http://localhost:5173

# ZORUNLU: Dashboard → Settings → API → JWT Secret
SUPABASE_JWT_SECRET=

# Güvensiz geliştirme modu üretimde ASLA açılmamalı.
API_ALLOW_INSECURE_AUTH=0
# Yalnızca API_ALLOW_INSECURE_AUTH=1 iken dikkate alınır.
API_JWT_BYPASS_USER_IDS=
# API_DEMO_USER_IDS=

# Açılışta supabase/migrations/*.sql dosyalarını otomatik uygular (/health -> db_schema: ok).
# Biri tanımlı değilse "skipped" olur ve yeni migration'ları elle uygulamanız gerekir
# (python3 scripts/apply_supabase_migration.py <dosya.sql>).
# SUPABASE_DATABASE_URL=postgresql://postgres:<parola>@db.<proje>.supabase.co:5432/postgres
# SUPABASE_DB_PASSWORD=

# Çok süreç / scale
# REDIS_URL=redis://redis:6379/0

# Mobil hatırlatıcı bildirimleri (push). İkisi de boşsa push kapalıdır; uygulama yerel bildirimle çalışır.
# Dağıtım anahtarı: güçlü rastgele bir değer, ör. `openssl rand -hex 32`. push-cron servisi bunu kullanır.
PUSH_DISPATCH_SECRET=
# Firebase → Proje ayarları → Hizmet hesapları → Yeni özel anahtar: JSON'un tamamı tek satır ya da dosya yolu.
FCM_SERVICE_ACCOUNT_JSON=
